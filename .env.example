BEA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
# auto uses live BEA data when configured, otherwise explicitly labeled demo data.
DATA_MODE=auto
CACHE_TTL_HOURS=24
# Set to 1 only behind the single trusted Nginx proxy described in README.
TRUST_PROXY=0
# Optional: absolute path outside repository to service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SPREADSHEET_ID=
